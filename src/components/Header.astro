---
import BipbopMarque from './mascotte/BipbopMarque.astro';

interface Props {
  currentPage?: string;
  cta?: 'comparatif' | 'demarrer';
}

const { currentPage = '', cta = 'comparatif' } = Astro.props;

const CTA = {
  comparatif: { label: 'Trouver ma batterie', href: '/comparatif-batterie-electronique/' },
  demarrer: { label: 'Par où commencer\u00a0?', href: '/guides/' },
}[cta];

const navItems = [
  { label: 'Comparatif', href: '/comparatif-batterie-electronique/', key: 'comparatif' },
  { label: 'Avis', href: '/avis/', key: 'avis' },
  { label: 'Guides', href: '/guides/', key: 'guides' },
  { label: 'À propos', href: '/a-propos/', key: 'a-propos' },
];
---

<header class="header" data-pad data-hdr>
  <a href="/" class="logo">
    <span class="logo-icon"><BipbopMarque /></span>
    <span class="logo-text">BipBop</span>
  </a>
  <nav class="nav" data-nav aria-label="Navigation principale">
    {navItems.map((item) => (
      <a
        href={item.href}
        class:list={{ active: currentPage === item.key }}
      >
        {item.label}
      </a>
    ))}
  </nav>
  <a href={CTA.href} class="cta-header">{CTA.label}</a>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 18px 40px;
    background: var(--color-creme);
    border-bottom: var(--border-epais) solid var(--color-encre);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
    color: var(--color-encre);
  }

  .logo-icon {
    width: 34px;
    height: 34px;
    flex: none;
    display: block;
  }

  .logo-text {
    font: 800 20px var(--font-titres);
    letter-spacing: -0.02em;
  }

  .nav {
    display: flex;
    gap: 24px;
    font: 500 14px var(--font-texte);
  }

  .nav a {
    color: var(--color-encre);
    text-decoration: none;
  }

  .nav a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .nav a.active {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2.5px;
    text-underline-offset: 5px;
    text-decoration-color: var(--color-corail);
  }

  .cta-header {
    font: 700 13px var(--font-texte);
    text-decoration: none;
    color: var(--color-encre);
    background: var(--color-jaune);
    border: var(--border-epais) solid var(--color-encre);
    padding: 9px 15px;
    border-radius: 10px;
    box-shadow: 3px 3px 0 var(--color-encre);
    transition: box-shadow 0.15s;
  }

  .cta-header:hover {
    box-shadow: 1px 1px 0 var(--color-encre);
    color: var(--color-encre);
  }

  /* Cibles tactiles : le Brief-Responsive §06 en laisse la charge à l'intégration.
     Sous 860 px, tout ce qui est cliquable dans l'en-tête atteint 44 px de haut
     sans changer le dessin au-delà. */
  @media (max-width: 860px) {
    .nav a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 2px;
    }
    .cta-header {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 16px;
    }
    .logo {
      min-height: 44px;
    }
  }
</style>
