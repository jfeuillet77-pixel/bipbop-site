---
import BaseLayout from '../layouts/BaseLayout.astro';
import BipbopAvatar from '../components/mascotte/BipbopAvatar.astro';

const featuredProducts = [
  {
    badge: 'LE CHOIX SÛR',
    badgeColor: 'var(--color-corail)',
    badgeTextColor: '#fff',
    badgeRotation: '-5deg',
    image: 'https://www.thomann.de/prodbilder/575657.jpg',
    marque: 'ALESIS',
    prix: '409 € environ',
    nom: 'Nitro Max Mesh',
    verdict: 'Si tu ne veux pas te prendre la tête et que tu as 400 € : celle-là, point.',
    prixHref: '/avis/alesis-nitro-max/',
    avisHref: '/avis/alesis-nitro-max/',
  },
  {
    badge: 'PETIT BUDGET',
    badgeColor: 'var(--color-turquoise)',
    badgeTextColor: '#fff',
    badgeRotation: '4deg',
    image: 'https://www.thomann.de/prodbilder/407855.jpg',
    marque: 'MILLENIUM',
    prix: '298 € environ',
    nom: 'MPS-150X Mesh',
    verdict: 'Des pads mesh à moins de 300 €, la marque maison de Thomann. Le vrai ticket d\'entrée.',
    prixHref: '/avis/millenium-mps-150x/',
    avisHref: '/avis/millenium-mps-150x/',
  },
  {
    badge: 'SI TU PEUX METTRE PLUS',
    badgeColor: 'var(--color-jaune)',
    badgeTextColor: 'var(--color-encre)',
    badgeRotation: '-3deg',
    image: 'https://www.thomann.de/prodbilder/557748.jpg',
    marque: 'ROLAND',
    prix: '498 € environ',
    nom: 'TD-02KV',
    verdict: 'Tu paies le module Roland et ça s\'entend. Revendable dans trois ans sans y perdre.',
    prixHref: '/avis/roland-td-02kv/',
    avisHref: '/avis/roland-td-02kv/',
  },
];

const faq = [
  {
    question: 'Mes voisins vont vraiment ne rien entendre ?',
    reponse: 'Presque. Les pads mesh sont discrets, mais la pédale de grosse caisse tape dans le plancher, c\'est ça qu\'on entend en dessous. Un tapis épais à 40 € règle 80 % du problème.',
  },
  {
    question: 'Une batterie à 250 €, c\'est un jouet ?',
    reponse: 'Non, mais c\'est une batterie à 250 €. Tu peux apprendre tes premiers rythmes dessus sans problème. Tu la remplaceras probablement au bout de deux ans si tu accroches.',
  },
];
---

<BaseLayout title="Apprendre la batterie sans que ton immeuble te déteste" currentPage="">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-content">
      <div class="hero-badge">31 MODÈLES SUIVIS</div>
      <h1>Apprendre la batterie<br />sans que ton immeuble<br />te déteste.</h1>
      <p class="hero-chapo">On compare les batteries électroniques et on te dit laquelle prendre selon ton budget, ta place et ce que tu veux en faire. En français, sans jargon et sans faire semblant qu'un modèle à 250 € vaut un modèle à 1 200 €.</p>
      <div class="hero-actions">
        <a href="/comparatif/" class="btn-primary">Trouver ma batterie en 3 questions</a>
        <a href="/les-bases/pad-mesh/" class="lien-secondaire">Je n'y connais vraiment rien →</a>
      </div>
    </div>
    <div class="hero-sidebar">
      <div class="hero-bulle">Neuf personnes sur dix qui arrivent ici cherchent la même chose : une batterie à moins de 500 € qui ne réveille personne. Bonne nouvelle, ça existe.</div>
      <div class="hero-mascotte">
        <div class="mascotte-avatar">
          <BipbopAvatar />
        </div>
        <div class="mascotte-label">BipBop<br />votre robot collecteur</div>
      </div>
    </div>
  </section>

  <!-- Trois portes -->
  <section class="portes">
    <a href="/comparatif/" class="porte">
      <div class="porte-num">01</div>
      <div class="porte-titre">Le comparatif</div>
      <p>Trois questions, deux modèles en face. Le plus rapide si tu sais déjà à peu près ton budget.</p>
      <span class="porte-cta">Comparer les 31 modèles →</span>
    </a>
    <a href="/guides/" class="porte">
      <div class="porte-num">02</div>
      <div class="porte-titre">Les guides par budget</div>
      <p>« Moins de 300 € », « moins de 500 € », « spécial appartement ». Un article, une réponse.</p>
      <span class="porte-cta turquoise">Voir les guides →</span>
    </a>
    <a href="/les-bases/pad-mesh/" class="porte">
      <div class="porte-num">03</div>
      <div class="porte-titre">Je pars de zéro</div>
      <p>C'est quoi un pad mesh, un module, une pédale à déclenchement ? On t'explique en dix minutes.</p>
      <span class="porte-cta encre">Commencer par les bases →</span>
    </a>
  </section>

  <!-- Recommandations -->
  <section class="reco-section">
    <div class="reco-header">
      <h2>Ce qu'on conseille en ce moment</h2>
      <div class="reco-line"></div>
      <div class="reco-date">MAJ 09 · 2026</div>
    </div>
    <div class="reco-grid">
      {featuredProducts.map((p) => (
        <article class="reco-card">
          <div class="reco-badge-wrap">
            <span
              class="reco-badge"
              style={`background:${p.badgeColor};color:${p.badgeTextColor};transform:rotate(${p.badgeRotation})`}
            >
              {p.badge}
            </span>
          </div>
          <div class="reco-image">
            <img src={p.image} alt={p.nom} />
          </div>
          <div class="reco-body">
            <div class="reco-marque">{p.marque} · {p.prix}</div>
            <h3>{p.nom}</h3>
            <p>{p.verdict}</p>
            <div class="reco-actions">
              <a href={p.prixHref} class="btn-prix">Voir le prix</a>
              <a href={p.avisHref} class="lien-avis">L'avis</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section">
    <div class="faq-grid">
      <div class="faq-intro">
        <h2>Les questions que tout le monde se pose</h2>
        <p>Celles qu'on n'ose pas poser en magasin de peur d'avoir l'air débutant. Spoiler : tu es débutant, c'est le but.</p>
      </div>
      <div class="faq-list">
        {faq.map((item) => (
          <div class="faq-item">
            <div class="faq-question">{item.question}</div>
            <p class="faq-reponse">{item.reponse}</p>
          </div>
        ))}
        <div class="faq-cta-row">
          <div class="faq-cta-text">Neuf autres questions, sans langue de bois.</div>
          <a href="/les-bases/pad-mesh/" class="btn-jaune">Tout lire</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Affiliation -->
  <section class="affiliation-section">
    <div class="mascotte-avatar small">
      <BipbopAvatar />
    </div>
    <div class="affiliation-text">
      <div class="affiliation-title">Comment on gagne notre vie</div>
      <p>Si tu achètes via nos liens Thomann, on touche une commission. Ton prix ne change pas et aucun classement n'a jamais bougé pour ça. On explique tout sur la page À propos.</p>
    </div>
    <a href="/a-propos/" class="btn-secondaire">Notre méthode</a>
  </section>

  <div class="spacer"></div>
</BaseLayout>

<style>
  .hero {
    padding: 64px 40px 52px;
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 44px;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 600 12px var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--color-encre);
    background: var(--color-turquoise-clair);
    border: var(--border-moyen) solid var(--color-encre);
    border-radius: 99px;
    padding: 6px 13px;
    margin-bottom: 22px;
  }

  .hero h1 {
    font: 800 68px/0.98 var(--font-titres);
    letter-spacing: -0.04em;
    margin: 0 0 22px;
    text-wrap: pretty;
  }

  .hero-chapo {
    font: 400 19px/1.55 var(--font-texte);
    color: var(--texte-secondaire);
    margin: 0 0 30px;
    max-width: 560px;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    align-items: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    font: 700 16px var(--font-texte);
    text-decoration: none;
    color: #fff;
    background: var(--color-corail);
    border: var(--border-epais) solid var(--color-encre);
    padding: 15px 24px;
    border-radius: 13px;
    box-shadow: 5px 5px 0 var(--color-encre);
    transition: box-shadow 0.15s;
  }

  .btn-primary:hover {
    box-shadow: 2px 2px 0 var(--color-encre);
    color: #fff;
  }

  .lien-secondaire {
    font: 600 15px var(--font-texte);
    color: var(--color-encre);
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--color-sable-clair);
  }

  .hero-sidebar {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-end;
  }

  .hero-bulle {
    position: relative;
    background: #fff;
    border: var(--border-epais) solid var(--color-encre);
    border-radius: 18px;
    padding: 17px 19px;
    font: 400 15px/1.5 var(--font-texte);
    box-shadow: 5px 5px 0 var(--color-encre);
    max-width: 330px;
  }

  .hero-mascotte {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .mascotte-avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    overflow: hidden;
    border: var(--border-epais) solid var(--color-encre);
    background: var(--color-jaune);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mascotte-avatar svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .mascotte-avatar.small {
    width: 56px;
    height: 56px;
    flex: none;
  }

  .mascotte-label {
    font: 500 13px/1.4 var(--font-mono);
    color: var(--texte-mono);
  }

  /* Portes */
  .portes {
    padding: 0 40px 20px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .porte {
    text-decoration: none;
    color: inherit;
    background: #fff;
    border: var(--border-epais) solid var(--color-encre);
    border-radius: 18px;
    padding: 24px;
    box-shadow: 5px 5px 0 var(--color-corail);
    display: block;
    transition: box-shadow 0.15s;
  }

  .porte:nth-child(2) { box-shadow: 5px 5px 0 var(--color-turquoise); }
  .porte:nth-child(3) { box-shadow: 5px 5px 0 var(--color-encre); }
  .porte:hover { box-shadow: 2px 2px 0 var(--color-corail); }
  .porte:nth-child(2):hover { box-shadow: 2px 2px 0 var(--color-turquoise); }
  .porte:nth-child(3):hover { box-shadow: 2px 2px 0 var(--color-encre); }

  .porte-num {
    font: 500 12px var(--font-mono);
    color: var(--texte-mono);
    margin-bottom: 12px;
  }

  .porte-titre {
    font: 700 22px/1.15 var(--font-titres);
    letter-spacing: -0.02em;
    margin-bottom: 9px;
  }

  .porte p {
    font: 400 15px/1.5 var(--font-texte);
    color: var(--texte-secondaire);
    margin: 0 0 14px;
  }

  .porte-cta {
    font: 700 14px var(--font-texte);
    color: var(--color-corail);
  }

  .porte-cta.turquoise { color: var(--color-turquoise-fonce); }
  .porte-cta.encre { color: var(--color-encre); }

  /* Recommandations */
  .reco-section {
    padding: 0 40px;
  }

  .reco-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 38px 0 20px;
  }

  .reco-header h2 {
    font: 800 30px var(--font-titres);
    letter-spacing: -0.025em;
  }

  .reco-line {
    flex: 1;
    height: 2.5px;
    background: var(--color-encre);
  }

  .reco-date {
    font: 500 13px var(--font-mono);
    color: var(--texte-mono);
  }

  .reco-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .reco-card {
    position: relative;
    background: #fff;
    border: var(--border-epais) solid var(--color-encre);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 5px 5px 0 var(--color-encre);
  }

  .reco-badge-wrap {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
  }

  .reco-badge {
    display: inline-block;
    font: 700 12px var(--font-titres);
    border: var(--border-epais) solid var(--color-encre);
    border-radius: 9px;
    padding: 6px 11px;
  }

  .reco-image {
    height: 168px;
    border-bottom: var(--border-epais) solid var(--color-encre);
    background: #fff;
  }

  .reco-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 8px;
    box-sizing: border-box;
  }

  .reco-body {
    padding: 18px 20px 20px;
  }

  .reco-marque {
    font: 500 12px var(--font-mono);
    color: var(--texte-mono);
    margin-bottom: 5px;
  }

  .reco-body h3 {
    font: 700 21px/1.15 var(--font-titres);
    letter-spacing: -0.02em;
    margin: 0 0 9px;
  }

  .reco-body p {
    font: 400 14.5px/1.5 var(--font-texte);
    color: var(--texte-carte);
    margin: 0 0 15px;
  }

  .reco-actions {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .btn-prix {
    font: 700 13.5px var(--font-texte);
    text-decoration: none;
    color: #fff;
    background: var(--color-corail);
    border: var(--border-epais) solid var(--color-encre);
    padding: 10px 14px;
    border-radius: 11px;
    box-shadow: 3px 3px 0 var(--color-encre);
    transition: box-shadow 0.15s;
  }

  .btn-prix:hover {
    box-shadow: 1px 1px 0 var(--color-encre);
    color: #fff;
  }

  .lien-avis {
    font: 600 13.5px var(--font-texte);
    color: var(--color-encre);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* FAQ */
  .faq-section {
    margin: 40px 40px 0;
    background: var(--color-encre);
    border-radius: 22px;
    padding: 36px 38px;
    color: var(--color-creme);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 40px;
    align-items: start;
  }

  .faq-intro h2 {
    font: 800 30px/1.1 var(--font-titres);
    letter-spacing: -0.025em;
    margin-bottom: 12px;
  }

  .faq-intro p {
    font: 400 15px/1.55 var(--font-texte);
    color: #b4a494;
    margin: 0;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-item {
    background: #302519;
    border-radius: 14px;
    padding: 18px 20px;
  }

  .faq-question {
    font: 700 16px var(--font-texte);
    margin-bottom: 7px;
  }

  .faq-reponse {
    font: 400 14.5px/1.55 var(--font-texte);
    color: #c4b7a7;
    margin: 0;
  }

  .faq-cta-row {
    background: #302519;
    border-radius: 14px;
    padding: 18px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .faq-cta-text {
    font: 500 15px var(--font-texte);
    color: #c4b7a7;
  }

  .btn-jaune {
    font: 700 13.5px var(--font-texte);
    text-decoration: none;
    color: var(--color-encre);
    background: var(--color-jaune);
    border: var(--border-epais) solid var(--color-jaune);
    padding: 10px 15px;
    border-radius: 11px;
    white-space: nowrap;
    transition: background 0.15s;
  }

  .btn-jaune:hover {
    background: var(--color-jaune-hover);
    border-color: var(--color-jaune-hover);
    color: var(--color-encre);
  }

  /* Affiliation */
  .affiliation-section {
    margin: 34px 40px 0;
    padding: 22px 24px;
    background: var(--color-turquoise-clair);
    border: var(--border-epais) solid var(--color-encre);
    border-radius: 18px;
    display: flex;
    align-items: flex-start;
    gap: 18px;
  }

  .affiliation-text {
    flex: 1;
  }

  .affiliation-title {
    font: 700 16px var(--font-texte);
    margin-bottom: 5px;
  }

  .affiliation-text p {
    font: 400 14.5px/1.55 var(--font-texte);
    color: var(--color-turquoise-clair-texte);
    margin: 0;
    max-width: 720px;
  }

  .btn-secondaire {
    font: 700 13.5px var(--font-texte);
    text-decoration: none;
    color: var(--color-encre);
    background: var(--color-creme);
    border: var(--border-epais) solid var(--color-encre);
    padding: 11px 15px;
    border-radius: 11px;
    box-shadow: 3px 3px 0 var(--color-encre);
    white-space: nowrap;
    transition: box-shadow 0.15s;
  }

  .btn-secondaire:hover {
    box-shadow: 1px 1px 0 var(--color-encre);
    color: var(--color-encre);
  }

  .spacer {
    height: 52px;
  }
</style>
