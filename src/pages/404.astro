---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page introuvable" description="La page que tu cherches n'existe pas." currentPage="">
  <section class="error-hero">
    <div class="error-code">404</div>
    <h1>Cette page n'existe pas.</h1>
    <p>Soit elle n'a jamais existé, soit on l'a déplacée. Voici les pages les plus utiles :</p>
    <div class="error-links">
      <a href="/" class="btn-primary">Accueil</a>
      <a href="/comparatif/" class="btn-secondaire">Le comparatif</a>
      <a href="/avis/" class="btn-secondaire">Tous les avis</a>
      <a href="/guides/" class="btn-secondaire">Tous les guides</a>
    </div>
  </section>

  <div class="spacer"></div>
</BaseLayout>

<style>
  .error-hero {
    padding: 80px 40px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .error-code {
    font: 800 120px/1 var(--font-titres);
    color: var(--color-sable-clair);
    letter-spacing: -0.04em;
    margin-bottom: 20px;
  }

  .error-hero h1 {
    font: 800 40px/1.1 var(--font-titres);
    letter-spacing: -0.03em;
    margin: 0 0 16px;
  }

  .error-hero p {
    font: 400 18px/1.55 var(--font-texte);
    color: var(--texte-secondaire);
    margin: 0 0 30px;
    max-width: 500px;
  }

  .error-links {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-primary {
    font: 700 15px var(--font-texte);
    text-decoration: none;
    color: #fff;
    background: var(--color-corail);
    border: var(--border-epais) solid var(--color-encre);
    padding: 13px 20px;
    border-radius: 12px;
    box-shadow: 4px 4px 0 var(--color-encre);
    transition: box-shadow 0.15s;
  }

  .btn-primary:hover {
    box-shadow: 1px 1px 0 var(--color-encre);
    color: #fff;
  }

  .btn-secondaire {
    font: 700 14px var(--font-texte);
    text-decoration: none;
    color: var(--color-encre);
    background: var(--color-creme);
    border: var(--border-epais) solid var(--color-encre);
    padding: 12px 18px;
    border-radius: 11px;
    box-shadow: 3px 3px 0 var(--color-encre);
    transition: box-shadow 0.15s;
  }

  .btn-secondaire:hover {
    box-shadow: 1px 1px 0 var(--color-encre);
    color: var(--color-encre);
  }

  .spacer {
    height: 52px;
  }
</style>
