---
import BaseLayout from '../../layouts/BaseLayout.astro';

const avisEnPreparation = {
  moinsDe300: [
    { nom: 'Millenium Rookie E-Drum Set', desc: 'Le kit le moins cher du marché. Pads caoutchouc, taille réduite : c\'est un premier contact, pas un instrument durable.', prix: '179 €', marchand: 'Thomann', marchandBg: 'var(--color-encre)', marchandColor: 'var(--color-jaune)', image: 'https://www.thomann.de/prodbilder/549098.jpg', href: 'https://www.thomann.fr/millenium_rookie_e_drum_set.htm?offid=1&affid=3711' },
    { nom: 'Alesis Turbo Mesh Kit', desc: 'Quatre fûts en peau maillée à 298 €. Les pads sont petits, le module basique, le toucher correct.', prix: '298 €', marchand: 'Thomann', marchandBg: 'var(--color-encre)', marchandColor: 'var(--color-jaune)', image: 'https://www.thomann.de/prodbilder/454813.jpg', href: 'https://www.thomann.fr/alesis_turbo_mesh_kit.htm?offid=1&affid=3711' },
    { nom: 'Alesis Debut Kit', desc: 'Un format réduit pensé pour les enfants, avec des peaux maillées quand même. Le rack descend assez bas.', prix: '279 €', marchand: 'Woodbrass', marchandBg: 'var(--color-turquoise-clair)', marchandColor: 'var(--color-turquoise-fonce)', image: 'https://www.woodbrass.com/images/woodbrass/ALESIS+DEBUTKIT.JPG', href: 'https://www.woodbrass.com/kit-electroniques-alesis-debutkit-mesh-kit-4-futs-3-cymbales-p340997.html' },
    { nom: 'Donner DED-70', desc: 'Le plancher de prix absolu, à moins de 200 €. Tout est en caoutchouc, mais ça se joue vraiment.', prix: '199,99 €', marchand: 'Donner Music', marchandBg: 'var(--color-rouge-clair)', marchandColor: 'var(--color-rouge-clair-texte)', image: 'https://cdn.shopify.com/s/files/1/0612/3120/2528/files/BatterieelectroniqueDonnerDED-70aveccasquesiegedebatterie_1.jpg?v=1741598803', href: 'https://donnnermusic.sjv.io/c/6882776/3379894/43895?prodsku=47112746893536&u=https%3A%2F%2Ffr.donnermusic.com%2Fproducts%2Fdonner-ded-70-electronic-drum-set&intsrc=CATF_28584' },
  ],
  '300a500': [
    { nom: 'Roland TD-02K V-Drums', desc: 'Les sons Roland pour 349 €, sans aucune peau maillée. La version mesh coûte 149 € de plus.', prix: '349 €', marchand: 'Thomann', marchandBg: 'var(--color-encre)', marchandColor: 'var(--color-jaune)', image: 'https://www.thomann.de/prodbilder/557719.jpg', href: 'https://www.thomann.fr/roland_td_02k_v_drums_kit.htm?offid=1&affid=3711' },
    { nom: 'Nux DM-110 Mesh Kit', desc: 'L\'outsider distribué par Woodbrass. Des peaux maillées partout, une marque moins connue.', prix: '349 €', marchand: 'Woodbrass', marchandBg: 'var(--color-turquoise-clair)', marchandColor: 'var(--color-turquoise-fonce)', image: 'https://www.woodbrass.com/images/woodbrass/PNU-DM-110.JPG', href: 'https://www.woodbrass.com/kit-electroniques-nux-dm-110-mesh-kit-p407936.html' },
    { nom: 'Yamaha DTX402K', desc: 'La Yamaha la moins chère. Pads en caoutchouc, mais l\'application d\'apprentissage est la meilleure du marché.', prix: '369 €', marchand: 'Thomann', marchandBg: 'var(--color-encre)', marchandColor: 'var(--color-jaune)', image: 'https://www.thomann.de/prodbilder/443798.jpg', href: 'https://www.thomann.fr/yamaha_dtx402k_e_drum_set.htm?offid=1&affid=3711' },
    { nom: 'Millenium MPS-450 E-Drum Set', desc: 'Cent euros de plus que l\'entrée de gamme, pour un module qui tient debout et des cymbales plus grandes.', prix: '398 €', marchand: 'Thomann', marchandBg: 'var(--color-encre)', marchandColor: 'var(--color-jaune)', image: 'https://www.thomann.de/prodbilder/454253.jpg', href: 'https://www.thomann.fr/millenium_mps_450_e_drum_set.htm?offid=1&affid=3711' },
    { nom: 'Woodbrass DDX50-Mesh', desc: 'Des pads de 10 pouces à 429 €, la caisse claire la plus confortable de sa tranche de prix.', prix: '429 €', marchand: 'Woodbrass', marchandBg: 'var(--color-turquoise-clair)', marchandColor: 'var(--color-turquoise-fonce)', image: 'https://www.woodbrass.com/images/woodbrass/PWB-DDX50-MESH.JPG', href: 'https://www.woodbrass.com/kit-electroniques-woodbrass-ddx50-mesh-p425216.html' },
    { nom: 'Yamaha DTX432K', desc: 'Le coaching Yamaha et une fiabilité reconnue, mais toujours aucune peau maillée à 498 €.', prix: '498 €', marchand: 'Thomann', marchandBg: 'var(--color-encre)', marchandColor: 'var(--color-jaune)', image: 'https://www.thomann.de/prodbilder/443801.jpg', href: 'https://www.thomann.fr/yamaha_dtx432k_e_drum_set.htm?offid=1&affid=3711' },
    { nom: 'Millenium MPS-750X E-Drum Mesh Set', desc: 'Huit pads en peau maillée et un rack costaud pour 498 €. Le plus de matériel du segment.', prix: '498 €', marchand: 'Thomann', marchandBg: 'var(--color-encre)', marchandColor: 'var(--color-jaune)', image: 'https://www.thomann.de/prodbilder/464015.jpg', href: 'https://www.thomann.fr/millenium_mps_750x_e_drum_mesh_set.htm?offid=1&affid=3711' },
    { nom: 'Donner DED-200X', desc: 'Cinq fûts et quatre cymbales, le kit le plus fourni sous 500 €. Son module reste en retrait.', prix: '499,99 €', marchand: 'Donner Music', marchandBg: 'var(--color-rouge-clair)', marchandColor: 'var(--color-rouge-clair-texte)', image: 'https://cdn.shopify.com/s/files/1/0612/3120/2528/files/5_6f759e66-464b-4495-8e59-713d28b965e7.jpg?v=1764927814', href: 'https://donnnermusic.sjv.io/c/6882776/3379894/43895?prodsku=7786764075232&u=https%3A%2F%2Ffr.donnermusic.com%2Fproducts%2Fdonner-ded-200-set-de-batterie-electronique&intsrc=CATF_28584' },
  ],
  '500a800': [
    { nom: 'Millenium MPS-850 E-Drum Set', desc: 'Le palier au-dessus : pads plus grands, module plus complet, rack de vraie batterie.', prix: '598 €', marchand: 'Thomann', marchandBg: 'var(--color-encre)', marchandColor: 'var(--color-jaune)', image: 'https://www.thomann.de/prodbilder/428224.jpg', href: 'https://www.thomann.fr/millenium_mps_850_e_drum_set.htm?offid=1&affid=3711' },
    { nom: 'Alesis Nitro Pro Drum Kit', desc: 'La marche suivante après la Nitro Max. Cymbales plus larges, module plus fin, presque 300 € de plus.', prix: '698 €', marchand: 'Thomann', marchandBg: 'var(--color-encre)', marchandColor: 'var(--color-jaune)', image: 'https://www.thomann.de/prodbilder/597347.jpg', href: 'https://www.thomann.fr/alesis_nitro_pro_drum_kit.htm?offid=1&affid=3711' },
    { nom: 'Alesis Nitro Ultimate Drum Kit', desc: 'Le haut de notre cible, à 799 €. Au-delà, on quitte le budget d\'un premier achat.', prix: '799 €', marchand: 'Thomann', marchandBg: 'var(--color-encre)', marchandColor: 'var(--color-jaune)', image: 'https://www.thomann.de/prodbilder/625865.jpg', href: 'https://www.thomann.fr/alesis_nitro_ultimate_drum_kit.htm?offid=1&affid=3711' },
  ],
  '800a1600': [
    { nom: 'Millenium MPS-1000 E-Drum Set', desc: 'Pour qui joue déjà et veut enregistrer. Le module le plus complet de la gamme Millenium.', prix: '999 €', marchand: 'Thomann', marchandBg: 'var(--color-encre)', marchandColor: 'var(--color-jaune)', image: 'https://www.thomann.de/prodbilder/511732.jpg', href: 'https://www.thomann.fr/millenium_mps_1000_e_drum_set.htm?offid=1&affid=3711' },
  ],
};
---

<BaseLayout title="Tous nos avis, modèle par modèle" description="Dix-neuf avis au programme, un par batterie qu'on estime valoir le coup d'être considérée. Trois sont écrits." currentPage="avis">

  <nav class="breadcrumb">ACCUEIL / AVIS</nav>

  <section class="hub-hero">
    <span class="badge corail">3 AVIS PUBLIÉS · 19 AU PROGRAMME</span>
    <h1>Tous nos avis, modèle par modèle</h1>
    <p>Dix-neuf avis au programme, un par batterie qu'on estime valoir le coup d'être considérée. Trois sont écrits. Chacun donne le prix réel, ce qui cloche et à qui le modèle s'adresse vraiment. Si tu cherches une réponse rapide plutôt qu'une lecture, passe par le comparatif.</p>
    <div class="hub-meta">
      <div class="hub-date">MIS À JOUR LE 11 SEPT. 2026</div>
      <span class="hub-sep">·</span>
      <a href="/comparatif/" class="hub-link-comparatif">Aller au comparatif</a>
    </div>
  </section>

  <!-- Recommandation Nº1 -->
  <section class="reco-une">
    <div class="reco-une-content">
      <span class="reco-une-badge">NOTRE RECOMMANDATION Nº1</span>
      <div class="reco-une-marque">ALESIS · 409 € chez Thomann</div>
      <div class="reco-une-nom">Nitro Max Kit</div>
      <p>Huit pads en mesh, du Bluetooth, un module qui tient la route. Si tu ne veux pas te prendre la tête et que tu as 400 €, c'est celle-là. Note de 8,4 sur 10.</p>
      <div class="reco-une-actions">
        <a href="/avis/alesis-nitro-max/" class="btn-corail">Lire l'avis complet</a>
        <a href="/duels/alesis-nitro-max-vs-donner-ded-200x/" class="lien-duel">Le duel contre la Donner</a>
      </div>
    </div>
    <div class="reco-une-image">
      <img src="https://www.thomann.de/prodbilder/575657.jpg" alt="ALESIS NITRO MAX" />
    </div>
  </section>

  <!-- Autres avis publiés -->
  <div class="section-header">
    <h2>Les autres avis publiés</h2>
    <div class="section-line"></div>
    <div class="section-count">2 AVIS</div>
  </div>

  <section class="avis-grid">
    <article class="avis-card">
      <div class="avis-card-image">
        <img src="https://www.thomann.de/prodbilder/407855.jpg" alt="Millenium MPS-150X E-Drum Mesh Set" />
      </div>
      <div class="avis-card-body">
        <div class="avis-card-marque">MILLENIUM · 298 €</div>
        <div class="avis-card-nom">MPS-150X E-Drum Mesh Set</div>
        <div class="avis-card-desc">Le mesh le moins cher du marché</div>
        <div class="avis-card-footer">
          <span class="avis-card-tag">Moins de 300 €</span>
          <a href="/avis/millenium-mps-150x/" class="btn-avis">Lire l'avis</a>
        </div>
      </div>
    </article>

    <article class="avis-card">
      <div class="avis-card-image">
        <img src="https://www.thomann.de/prodbilder/557748.jpg" alt="Roland TD-02KV V-Drums" />
      </div>
      <div class="avis-card-body">
        <div class="avis-card-marque">ROLAND · 498 €</div>
        <div class="avis-card-nom">TD-02KV V-Drums</div>
        <div class="avis-card-desc">Le plus discret</div>
        <div class="avis-card-footer">
          <span class="avis-card-tag">300 à 500 €</span>
          <a href="/avis/roland-td-02kv/" class="btn-avis">Lire l'avis</a>
        </div>
      </div>
    </article>

    <div class="avis-card-placeholder">
      <div class="placeholder-title">Les 16 suivants arrivent</div>
      <p>On publie dans l'ordre de ce que les lecteurs cherchent le plus. En attendant, le modèle est déjà comparé et son prix suivi.</p>
      <a href="/comparatif/" class="placeholder-link">Passer par le comparatif →</a>
    </div>
  </section>

  <!-- 16 avis en préparation -->
  <div class="section-header">
    <h2>Les 16 avis en préparation</h2>
    <div class="section-line"></div>
  </div>
  <p class="intro-preparation">Ces modèles sont suivis, leurs prix sont relevés chaque semaine et ils figurent déjà dans le comparatif. Leur avis détaillé reste à écrire. Le lien va directement chez le marchand.</p>

  {Object.entries(avisEnPreparation).map(([tranche, produits]) => (
    <div class="tranche-section">
      <div class="tranche-header">
        <div class="tranche-titre">
          {tranche === 'moinsDe300' ? 'Moins de 300 €' :
           tranche === '300a500' ? '300 à 500 €' :
           tranche === '500a800' ? '500 à 800 €' :
           '800 à 1600 €'}
        </div>
        <div class="tranche-line"></div>
        <div class="tranche-count">{produits.length}</div>
      </div>
      <div class="tranche-table">
        {produits.map((p, i) => (
          <div class={`tranche-row ${i % 2 === 0 ? 'bg-white' : 'bg-creme'}`}>
            <div class="tranche-img">
              <img src={p.image} alt={p.nom} />
            </div>
            <div class="tranche-info">
              <div class="tranche-nom">{p.nom}</div>
              <div class="tranche-desc">{p.desc}</div>
            </div>
            <div class="tranche-prix">{p.prix}</div>
            <div class="tranche-marchand">
              <span class="marchand-tag" style={`background:${p.marchandBg};color:${p.marchandColor}`}>{p.marchand}</span>
            </div>
            <a href={p.href} rel="sponsored noopener" target="_blank" class="tranche-link">Voir le prix</a>
          </div>
        ))}
      </div>
    </div>
  ))}

  <!-- Duels -->
  <div class="section-header duels-header">
    <h2>Les duels</h2>
    <div class="section-line"></div>
    <div class="section-count-duel">QUAND L'HÉSITATION PORTE SUR DEUX MODÈLES</div>
  </div>

  <section class="duels-grid">
    <div class="duel-card" style="box-shadow:6px 6px 0 var(--color-corail)">
      <div class="duel-images">
        <div class="duel-img"><img src="https://www.thomann.de/prodbilder/575657.jpg" alt="ALESIS NITRO MAX" /></div>
        <div class="duel-img"><img src="https://cdn.shopify.com/s/files/1/0612/3120/2528/files/5_6f759e66-464b-4495-8e59-713d28b965e7.jpg?v=1764927814" alt="DONNER DED-200X" /></div>
        <div class="duel-vs">VS</div>
      </div>
      <div class="duel-titre">Nitro Max contre DED-200X</div>
      <p>Quatre-vingt-onze euros d'écart et neuf pads contre huit. Le moins cher n'est pas celui qu'on croit.</p>
      <a href="/duels/alesis-nitro-max-vs-donner-ded-200x/" class="btn-duel">Voir le duel</a>
    </div>

    <div class="duel-card" style="box-shadow:6px 6px 0 var(--color-turquoise)">
      <div class="duel-images">
        <div class="duel-img"><img src="https://www.thomann.de/prodbilder/575657.jpg" alt="ALESIS NITRO MAX" /></div>
        <div class="duel-img"><img src="https://www.thomann.de/prodbilder/557748.jpg" alt="ROLAND TD-02KV" /></div>
        <div class="duel-vs">VS</div>
      </div>
      <div class="duel-titre">Nitro Max contre TD-02KV</div>
      <p>Deux pads de moins chez Roland, quatre-vingt-dix euros de plus. La question du module.</p>
      <div class="duel-bientot">En préparation</div>
    </div>

    <div class="duel-card" style="box-shadow:6px 6px 0 var(--color-encre)">
      <div class="duel-images">
        <div class="duel-img"><img src="https://www.thomann.de/prodbilder/407855.jpg" alt="MILLENIUM MPS-150X" /></div>
        <div class="duel-img"><img src="https://www.thomann.de/prodbilder/454813.jpg" alt="ALESIS TURBO MESH" /></div>
        <div class="duel-vs">VS</div>
      </div>
      <div class="duel-titre">MPS-150X contre Turbo Mesh</div>
      <p>Le match des batteries mesh à 298 €. Le mieux équipé n'est pas celui qu'on croit.</p>
      <div class="duel-bientot">En préparation</div>
    </div>
  </section>

  <!-- Méthodologie -->
  <section class="methodo">
    <div class="methodo-titre">Comment on choisit les modèles</div>
    <div class="methodo-texte">
      <p>On part de ce que les gens cherchent réellement, pas de ce que les marques veulent pousser. Un modèle entre dans la liste s'il coche au moins deux critères : il est disponible en France chez un marchand fiable, il coûte moins de 1 600 €, il revient souvent dans les questions qu'on reçoit.</p>
      <p>Un modèle qui sort du catalogue sort de la liste. Un avis qui n'a pas été revu depuis six mois porte la mention qui va avec.</p>
    </div>
  </section>

  <div class="spacer"></div>
</BaseLayout>

<style>
  .breadcrumb { padding: 22px 40px 0; font: 500 12.5px var(--font-mono); color: var(--texte-mono); }

  .hub-hero { padding: 20px 40px 30px; max-width: 860px; }

  .badge { display: inline-flex; align-items: center; gap: 8px; font: 700 12px var(--font-texte); letter-spacing: 0.04em; border: var(--border-epais) solid var(--color-encre); border-radius: 9px; padding: 6px 12px; margin-bottom: 20px; }
  .badge.corail { background: var(--color-corail); color: #fff; }

  .hub-hero h1 { font: 800 56px/1.02 var(--font-titres); letter-spacing: -0.035em; margin: 0 0 18px; text-wrap: pretty; }
  .hub-hero p { font: 400 20px/1.55 var(--font-texte); color: var(--texte-secondaire); margin: 0 0 20px; max-width: 720px; text-wrap: pretty; }

  .hub-meta { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .hub-date { font: 500 13px var(--font-mono); color: var(--texte-mono); }
  .hub-sep { color: var(--color-sable-clair); }
  .hub-link-comparatif { font: 600 14px var(--font-texte); color: var(--color-encre); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; text-decoration-color: var(--color-corail); }

  /* Recommandation Nº1 */
  .reco-une { margin: 0 40px 34px; display: grid; grid-template-columns: 1.2fr 1fr; gap: 22px; background: var(--color-jaune); border: var(--border-epais) solid var(--color-encre); border-radius: 22px; padding: 26px; box-shadow: 7px 7px 0 var(--color-encre); align-items: center; }
  .reco-une-badge { display: inline-block; font: 700 11.5px var(--font-texte); letter-spacing: 0.05em; background: var(--color-corail); color: #fff; border: var(--border-epais) solid var(--color-encre); border-radius: 8px; padding: 5px 10px; margin-bottom: 14px; }
  .reco-une-marque { font: 500 12px var(--font-mono); color: var(--texte-secondaire); margin-bottom: 6px; }
  .reco-une-nom { font: 800 36px/1.05 var(--font-titres); letter-spacing: -0.03em; margin-bottom: 12px; }
  .reco-une-content p { font: 400 16.5px/1.6 var(--font-texte); color: var(--texte-principal); margin: 0 0 20px; max-width: 460px; }
  .reco-une-actions { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .btn-corail { font: 700 15px var(--font-texte); text-decoration: none; color: #fff; background: var(--color-corail); border: var(--border-epais) solid var(--color-encre); padding: 13px 20px; border-radius: 12px; box-shadow: 4px 4px 0 var(--color-encre); transition: box-shadow 0.15s; }
  .btn-corail:hover { box-shadow: 1px 1px 0 var(--color-encre); color: #fff; }
  .lien-duel { font: 600 14px var(--font-texte); color: var(--color-encre); text-decoration: underline; text-underline-offset: 4px; }
  .reco-une-image { height: 230px; border: var(--border-epais) solid var(--color-encre); border-radius: 16px; overflow: hidden; }
  .reco-une-image img { width: 100%; height: 100%; object-fit: contain; padding: 8px; box-sizing: border-box; background: #fff; }

  /* Section headers */
  .section-header { display: flex; align-items: center; gap: 14px; margin: 0 40px 20px; }
  .section-header h2 { font: 800 26px var(--font-titres); letter-spacing: -0.025em; }
  .section-line { flex: 1; height: 2.5px; background: var(--color-encre); }
  .section-count { font: 500 12.5px var(--font-mono); color: var(--texte-mono); }
  .section-count-duel { font: 500 12.5px var(--font-mono); color: var(--texte-mono); }
  .duels-header { margin-top: 38px; }

  /* Avis grid */
  .avis-grid { margin: 0 40px 38px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .avis-card { background: #fff; border: var(--border-epais) solid var(--color-encre); border-radius: 18px; overflow: hidden; box-shadow: 5px 5px 0 var(--color-encre); display: flex; flex-direction: column; }
  .avis-card-image { height: 158px; border-bottom: var(--border-epais) solid var(--color-encre); background: #fff; }
  .avis-card-image img { width: 100%; height: 100%; object-fit: contain; padding: 10px; box-sizing: border-box; }
  .avis-card-body { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 9px; flex: 1; }
  .avis-card-marque { font: 500 11.5px var(--font-mono); color: var(--texte-mono); }
  .avis-card-nom { font: 700 19px/1.15 var(--font-titres); letter-spacing: -0.02em; }
  .avis-card-desc { font: 400 13.5px/1.45 var(--font-texte); color: var(--texte-carte); flex: 1; }
  .avis-card-footer { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 4px; }
  .avis-card-tag { font: 600 11.5px var(--font-texte); padding: 4px 9px; border-radius: 7px; background: var(--color-creme); border: var(--border-moyen) solid var(--color-sable-clair); color: var(--texte-secondaire); white-space: nowrap; }
  .btn-avis { font: 700 13px var(--font-texte); text-decoration: none; color: #fff; background: var(--color-corail); border: var(--border-epais) solid var(--color-encre); padding: 8px 13px; border-radius: 10px; box-shadow: 3px 3px 0 var(--color-encre); white-space: nowrap; transition: box-shadow 0.15s; }
  .btn-avis:hover { box-shadow: 1px 1px 0 var(--color-encre); color: #fff; }

  .avis-card-placeholder { background: var(--color-turquoise-clair); border: var(--border-epais) solid var(--color-encre); border-radius: 18px; padding: 22px 24px; display: flex; flex-direction: column; justify-content: center; gap: 10px; }
  .placeholder-title { font: 800 21px/1.15 var(--font-titres); letter-spacing: -0.02em; color: var(--color-turquoise-fonce); }
  .avis-card-placeholder p { font: 400 14.5px/1.55 var(--font-texte); color: var(--color-turquoise-clair-texte); margin: 0; }
  .placeholder-link { font: 700 13.5px var(--font-texte); color: var(--color-turquoise-fonce); text-decoration: underline; text-underline-offset: 4px; margin-top: 2px; }

