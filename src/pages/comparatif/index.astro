---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BipbopAvatar from '../../components/mascotte/BipbopAvatar.astro';
import { ETAT_INITIAL, resultat } from '../../lib/comparatif.mjs';
import { questionsHTML, resultatHTML } from '../../lib/comparatif-ui.mjs';

// Premier état rendu au build : la page se lit sans JavaScript, et le navigateur
// affiche exactement la même chose une fois les réponses changées.
const vue = resultat(ETAT_INITIAL);
const RELEVE = '13 septembre 2026';
---

<BaseLayout title="Comparatif interactif" description="Trois questions, deux modèles en face. Le comparatif de batteries électroniques pour débutants." currentPage="comparatif">
  <div data-rwd="sp" data-pad style="display:grid;grid-template-columns:1fr 330px;gap:40px;padding:46px 40px 34px;align-items:start">
    <div>
      <h1 data-big="b" style="font:800 60px/1.02 'Bricolage Grotesque',sans-serif;letter-spacing:-.035em;margin:0 0 20px;text-wrap:pretty">Dis-moi trois trucs.<br />Je te dis quoi acheter.</h1>
      <p style="font:400 18px/1.55 'Work Sans',sans-serif;color:#5a4c3e;margin:0;max-width:560px;text-wrap:pretty">Pas de tableau de 40 lignes, pas de specs que personne ne comprend. Trois questions, deux modèles en face et une phrase honnête sur chacun.</p>
    </div>
    <div style="display:flex;gap:14px;align-items:flex-start">
      <div style="width:76px;height:76px;flex:none;border-radius:50%;overflow:hidden;border:2.5px solid #241c14;background:#ffd166"><BipbopAvatar /></div>
      <div style="position:relative;background:#fff;border:2.5px solid #241c14;border-radius:16px;padding:15px 17px;font:400 14.5px/1.45 'Work Sans',sans-serif;box-shadow:4px 4px 0 #241c14">
        Salut, moi c'est BipBop. Je teste des batteries toute la journée parce que je n'ai pas de voisins. Toi, tu en as. On va faire ça bien.
      </div>
    </div>
  </div>

  <div data-rwd="c3" data-mar style="margin:0 40px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px" set:html={questionsHTML(ETAT_INITIAL)} />

  <div data-mar style="display:flex;align-items:center;gap:14px;margin:34px 40px 18px;flex-wrap:wrap">
    <div data-big="d" id="titre-resultat" style="font:800 26px 'Bricolage Grotesque',sans-serif;letter-spacing:-.02em">{vue.titreResultat}</div>
    <div style="flex:1;min-width:40px;height:2.5px;background:#241c14"></div>
  </div>

  <div id="zone-resultat" set:html={resultatHTML(vue)} />

  <div data-mar style="margin:0 40px 8px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;font:400 14px/1.5 'Work Sans',sans-serif;color:#786550">
    <span>Prix relevés chez Thomann, Woodbrass et Donner Music le {RELEVE}. Liens affiliés : on touche une commission, ton prix ne bouge pas.</span>
  </div>
  <div style="height:52px"></div>
</BaseLayout>

<script>
  import { ETAT_INITIAL, resultat, OPTIONS } from '../../lib/comparatif.mjs';
  import { questionsHTML, resultatHTML } from '../../lib/comparatif-ui.mjs';

  const CLE = { budget: 'b', place: 'p', usage: 'u' };
  const questions = document.querySelector('[data-rwd="c3"]');
  const titre = document.getElementById('titre-resultat');
  const zone = document.getElementById('zone-resultat');

  function depuisUrl() {
    const p = new URLSearchParams(location.search);
    const etat = { ...ETAT_INITIAL };
    for (const [cle, court] of Object.entries(CLE)) {
      const v = p.get(court);
      if (OPTIONS[cle].some(([val]) => val === v)) etat[cle] = v;
    }
    return etat;
  }

  let etat = depuisUrl();

  function afficher() {
    questions.innerHTML = questionsHTML(etat);
    const v = resultat(etat);
    titre.textContent = v.aResultat ? v.titreResultat : 'Je cherche…';
    zone.innerHTML = resultatHTML(v);
  }

  questions.addEventListener('click', (e) => {
    const b = e.target.closest('[data-choisir]');
    if (!b) return;
    etat = { ...etat, [b.dataset.choisir]: b.dataset.valeur };
    const p = new URLSearchParams(location.search);
    p.set(CLE[b.dataset.choisir], b.dataset.valeur);
    history.replaceState(null, '', location.pathname + '?' + p.toString());
    afficher();
  });

  zone.addEventListener('click', (e) => {
    if (!e.target.closest('[data-reinitialiser]')) return;
    etat = { ...ETAT_INITIAL };
    const p = new URLSearchParams(location.search);
    Object.values(CLE).forEach((k) => p.delete(k));
    history.replaceState(null, '', location.pathname + (p.toString() ? '?' + p : ''));
    afficher();
  });

  afficher();
</script>
