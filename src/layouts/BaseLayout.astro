---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';
import '../styles/responsive.css';

interface Props {
  title: string;
  description?: string;
  currentPage?: string;
  /** « demarrer » = le CTA « Par où commencer ? » vers Guides, que la maquette ne réserve qu'au comparatif. */
  cta?: 'comparatif' | 'demarrer';
}

const { title, description = 'Des recommandations de batteries électroniques pour les gens qui débutent, en français et sans jargon.', currentPage = '', cta = 'comparatif' } = Astro.props;

// Canonical au même endroit que les pages portées (`scripts/port.mjs` le reprend du permalien
// du plan éditorial) : bipbop.eu sans www, chemin avec barre oblique finale, comme le sitemap.
const canonique = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {/* Aucune balise robots : les pages qui passent par ici sont indexables depuis l'ouverture
        SEO du 13/09 au soir. C'est `scripts/port.mjs` qui en écrit une, et uniquement sur la 404. */}
    <link rel="canonical" href={canonique} />
    <link rel="icon" type="image/svg+xml" href="/bipbop-marque.svg" />
    <link rel="apple-touch-icon" href="/bipbop-touch-180.png" />
    {/* Le title est publié tel qu'il est écrit dans la prop : la marque n'y est pas ajoutée ici,
        elle ne figure dans aucun title du site depuis la passe SEO du 14/09 (elle ne porte aucune
        requête et mange 9 caractères sur une plage de 50 à 60). `scripts/port.mjs` fait pareil. */}
    <title>{title}</title>
  </head>
  <body>
    <div class="site-wrapper">
      <Header currentPage={currentPage} cta={cta} />
      <main>
        <slot />
      </main>
      <Footer />
      <CookieBanner />
    </div>
  </body>
</html>

<style>
  .site-wrapper {
    max-width: var(--max-width);
    margin: 0 auto;
    background: var(--color-creme);
    font-family: var(--font-texte);
    color: var(--color-encre);
    min-height: 100vh;
  }
</style>
